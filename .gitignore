# Python ve yerel ortam
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.venv/
.uv-cache/
.env
.env.*
!.env.example
logs/**
!logs/.gitkeep

# Editör ve notebook
.idea/
.vscode/
.DS_Store
.ipynb_checkpoints/

# Veri dosyaları yerelde kalır; klasörler .gitkeep ile izlenir.
data/raw/**
data/judged/**
data/search_cache/**
data/search_overrides/**
data/interim/**
data/processed/**
data/superseded/**
!data/raw/.gitkeep
!data/judged/.gitkeep
!data/search_cache/.gitkeep
!data/search_overrides/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/superseded/.gitkeep

# Fold atamaları türetilmiş veri değil, deney tanımıdır: aynı bölme olmadan
# hiçbir skor yeniden üretilemez, bu yüzden sürümlenir.
!data/processed/modeling/
!data/processed/modeling/splits_*.json

# Pipeline logları rapor klasörüne düşerse izlenmez.
reports/**/*.log

# Üretilmiş teslim paketleri; `make team-report-pdf` ve paketleme betikleriyle yeniden üretilir.
output/**
